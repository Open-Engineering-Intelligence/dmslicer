{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Open-Engineering-Intelligence/dmslicer/blob/main/docs/evidence_preservation/schemas/promotion_request.schema.json",
  "title": "DM-Slicer P2 MVP Evidence Promotion Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "run_id",
    "identity",
    "source",
    "environment",
    "execution",
    "tolerances",
    "results",
    "history",
    "custody",
    "geometry_validation"
  ],
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"
    },
    "artifactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifactId"}
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_artifact_ids"],
      "properties": {
        "status": {"type": "string"},
        "evidence_artifact_ids": {"$ref": "#/$defs/artifactIds"}
      }
    },
    "unprovenGeometryResult": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "status": {"const": "GEOMETRIC_EQUIVALENCE_NOT_PROVEN"},
            "evidence_artifact_ids": {"maxItems": 0}
          }
        }
      ]
    },
    "unprovenSemanticResult": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "status": {"const": "SEMANTIC_EQUIVALENCE_NOT_PROVEN"},
            "evidence_artifact_ids": {"maxItems": 0}
          }
        }
      ]
    },
    "unprovenUiResult": {
      "allOf": [
        {"$ref": "#/$defs/result"},
        {
          "properties": {
            "status": {"const": "UI_STATE_NOT_PROVEN"},
            "evidence_artifact_ids": {"maxItems": 0}
          }
        }
      ]
    },
    "allowlistArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "source_path",
        "public_path",
        "kind",
        "validation_role",
        "retention_role"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/artifactId"},
        "source_path": {"type": "string", "minLength": 1},
        "public_path": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["JUNIT", "VALIDATOR", "JSON", "TEXT", "STEP", "BREP", "FCSTD", "VIEW_INDEX", "HUMAN_REVIEW", "OTHER"]
        },
        "validation_role": {"type": "string", "minLength": 1},
        "retention_role": {
          "type": "string",
          "enum": ["STANDARD", "FAILURE", "MISMATCH", "REJECTION", "REVIEWER_FINDING"]
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "goal_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "implementation_commit", "parent_baseline", "merge_base"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "implementation_commit": {"$ref": "#/$defs/commit"},
        "parent_baseline": {"$ref": "#/$defs/commit"},
        "merge_base": {"$ref": "#/$defs/commit"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["staging_root", "allowlist"],
      "properties": {
        "staging_root": {"type": "string", "minLength": 1},
        "allowlist": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/allowlistArtifact"}
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "pytest_version", "freecad_version", "occt_version"],
      "properties": {
        "python_version": {"type": "string", "minLength": 1},
        "pytest_version": {"type": "string", "minLength": 1},
        "freecad_version": {"type": ["string", "null"]},
        "occt_version": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "timestamp"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "tolerances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "role", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_identity_result",
        "geometry_equivalence_result",
        "semantic_equivalence_result",
        "ui_state_result",
        "pytest_result",
        "validator_result",
        "scientific_experiment_result",
        "human_inspection_result"
      ],
      "properties": {
        "byte_identity_result": {
          "allOf": [
            {"$ref": "#/$defs/result"},
            {"properties": {"status": {"enum": ["BYTE_SAME", "BYTE_DIFFERENT", "BYTE_NOT_EVALUATED"]}}}
          ]
        },
        "geometry_equivalence_result": {"$ref": "#/$defs/unprovenGeometryResult"},
        "semantic_equivalence_result": {"$ref": "#/$defs/unprovenSemanticResult"},
        "ui_state_result": {"$ref": "#/$defs/unprovenUiResult"},
        "pytest_result": {"$ref": "#/$defs/result"},
        "validator_result": {"$ref": "#/$defs/result"},
        "scientific_experiment_result": {"$ref": "#/$defs/result"},
        "human_inspection_result": {"$ref": "#/$defs/result"}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_artifact_ids", "mismatch_artifact_ids", "rejection_artifact_ids", "reviewer_finding_artifact_ids"],
      "properties": {
        "failure_artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "mismatch_artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "rejection_artifact_ids": {"$ref": "#/$defs/artifactIds"},
        "reviewer_finding_artifact_ids": {"$ref": "#/$defs/artifactIds"}
      }
    },
    "custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off_host_copies", "publication_authorized"],
      "properties": {
        "off_host_copies": {"type": "array", "maxItems": 0},
        "publication_authorized": {"const": false}
      }
    },
    "geometry_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_method", "evidence_artifact_ids", "sha256_role"],
      "properties": {
        "status": {"const": "GEOMETRIC_EQUIVALENCE_NOT_PROVEN"},
        "evidence_method": {"const": "NOT_EVALUATED_P2_MVP"},
        "evidence_artifact_ids": {"type": "array", "maxItems": 0},
        "sha256_role": {"const": "file_and_copy_integrity_only_not_geometry_equivalence"}
      }
    }
  }
}
